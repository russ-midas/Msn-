{
  "expo": {
    "name": "Retro Messenger",
    "slug": "retro-messenger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "retromessenger",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E5128"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.retromessenger.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Retro Messenger to access your camera for profile pictures and sharing photos.",
        "NSPhotoLibraryUsageDescription": "Allow Retro Messenger to access your photo library for sharing photos.",
        "NSMicrophoneUsageDescription": "Allow Retro Messenger to access your microphone for voice messages."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E5128"
      },
      "package": "com.retromessenger.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "sounds": ["./assets/sounds/message.wav", "./assets/sounds/nudge.wav", "./assets/sounds/online.wav", "./assets/sounds/offline.wav"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
